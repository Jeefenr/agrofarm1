sequenceDiagram
    participant DemoMain
    participant DatabaseModule
    participant FieldIdentityModule
    participant Injector
    participant TechOperationStore
    participant SQLiteTechOperationStore
    participant HtmlReportGenerator
    participant Agronomist
    participant Operator
    participant Storekeeper
    participant Field
    participant TechOperation
    participant WeatherService
    participant FieldWork
    participant CropYieldAnalysis

    DemoMain->>DatabaseModule: створити модуль бази даних
    DemoMain->>Injector: Guice.createInjector(DatabaseModule)
    DatabaseModule-->>Injector: binding сховища та спільне JDBC-з'єднання
    loop Для кожного демонстраційного поля
        DemoMain->>FieldIdentityModule: створити модуль з ID і назвою
        DemoMain->>Injector: createChildInjector(FieldIdentityModule)
        Injector->>Field: getInstance(Field.class)
        Injector->>TechOperationStore: впровадити сховище в конструктор
        TechOperationStore-->>Field: залежність сховища
        Field-->>DemoMain: створений об'єкт поля
    end
    DemoMain->>TechOperation: створити оранку та сівбу
    DemoMain->>Field: addOperation для кожного поля
    DemoMain->>Agronomist: створити учасника
    DemoMain->>Operator: створити з WeatherService
    DemoMain->>Storekeeper: створити учасника

    DemoMain->>Agronomist: selectSeason(season)
    DemoMain->>Agronomist: planCropRotation(northField, season, "пшениця")
    Agronomist->>Field: assignCropPlan(season, crop)
    Field-->>Agronomist: план поля збережено
    DemoMain->>Agronomist: planCropRotation(southField, season, "кукурудза")
    Agronomist->>Field: assignCropPlan(season, crop)
    Field-->>Agronomist: план поля збережено

    DemoMain->>Operator: selectSeason(season)
    loop Для кожного поля: північного з оранкою та південного із сівбою
        DemoMain->>Operator: planFieldWork(field, season, operation)
        Operator->>FieldWork: FieldWork(field, season, operation, weatherService)
        FieldWork-->>Operator: створено зі статусом PLANNED / ЗАПЛАНОВАНО
        DemoMain->>Operator: recordFieldWork(work)
        Operator->>FieldWork: complete()
        activate FieldWork
        alt Поле, сезон і тип операції визначені
            FieldWork->>Field: hasOperation(operation)
            alt Операція належить полю
                FieldWork->>WeatherService: getModeledContext(fieldId, season)
                alt Модельований прогноз доступний
                    WeatherService-->>FieldWork: модельований погодний контекст
                else Прогноз недоступний
                    WeatherService-->>FieldWork: Optional.empty()
                    Note over FieldWork: Повідомити про недоступність прогнозу, фактичні умови не визначено
                end
                FieldWork->>TechOperation: plan()
                TechOperation-->>FieldWork: заплановану дію повідомлено в консолі
                Note over FieldWork: complete() змінює статус PLANNED → COMPLETED
                FieldWork-->>Operator: true — статус COMPLETED / ВИКОНАНО
            else Операція належить іншому полю
                Note over FieldWork: Повідомити про невідповідність; статус лишається PLANNED
                FieldWork-->>Operator: false — статус PLANNED / ЗАПЛАНОВАНО
            end
        else Бракує поля, сезону або типу операції
            Note over FieldWork: Повідомити про відсутні дані, статус лишається PLANNED
            FieldWork-->>Operator: false — статус PLANNED / ЗАПЛАНОВАНО
        end
        deactivate FieldWork
    end

    DemoMain->>Storekeeper: selectSeason(season)
    loop Для кожного поля з демонстраційним надходженням
        DemoMain->>Storekeeper: recordHarvest(field, season, receiptId, quantity)
        Storekeeper->>Field: validateHarvest(receiptId, season, quantity)
        alt Перевірки успішні
            Storekeeper->>Field: recordHarvest(receiptId, season, quantity)
            Field-->>Storekeeper: надходження обліковано один раз
            Storekeeper-->>DemoMain: true — надходження обліковано
        else Дані невалідні або повторні
            Field-->>Storekeeper: причина відмови без зміни обліку
            Storekeeper-->>DemoMain: false — відхилення з причиною
        end
    end

    DemoMain->>Agronomist: requestYieldAnalysis(analysis, season, fields)
    Agronomist->>CropYieldAnalysis: analyzeSeason(season, fields)
    CropYieldAnalysis->>CropYieldAnalysis: hasDataForSeason(season, fields)
    alt Є обліковані надходження за сезон
        loop Для кожного поля зі списку
            CropYieldAnalysis->>Field: getHarvestForSeason(season)
            Field-->>CropYieldAnalysis: кількість або OptionalDouble.empty()
        end
        CropYieldAnalysis-->>Agronomist: порівняння за полями вибраного сезону
        Agronomist-->>DemoMain: результат requestYieldAnalysis
    else Надходжень немає
        Agronomist-->>DemoMain: повідомлення про відсутність даних, не нульова урожайність
    end

    loop Для кожної призначеної технічної операції
        DemoMain->>Field: saveOperation(operation)
        Field->>TechOperationStore: save(OperationRecord)
        TechOperationStore->>SQLiteTechOperationStore: параметризований UPSERT
        SQLiteTechOperationStore-->>TechOperationStore: запис збережено або помилка
        TechOperationStore-->>Field: результат збереження
        Field-->>DemoMain: результат окремого запису
    end
    DemoMain->>TechOperationStore: findAll()
    TechOperationStore->>SQLiteTechOperationStore: прочитати всі записи
    alt Читання не вдалося
        SQLiteTechOperationStore-->>DemoMain: повідомлення про помилку; звіт не створюється
    else Читання успішне
        SQLiteTechOperationStore-->>DemoMain: фактичні записи з бази
        DemoMain->>HtmlReportGenerator: generate(records, saveErrors)
        alt Є помилки збереження
            HtmlReportGenerator-->>DemoMain: HTML із записами та попередженням
        else Усі записи збережено
            HtmlReportGenerator-->>DemoMain: HTML із фактичними записами
        end
    end
