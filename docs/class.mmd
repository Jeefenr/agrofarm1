classDiagram
    class FarmParticipant {
        <<abstract>>
        -String participantId
        -String name
        +FarmParticipant(String participantId, String name)
        +String getName()
        +final String getParticipantId()
        +abstract void selectSeason(String season)
    }

    class IWorkPlan {
        <<interface>>
        +void selectSeason(String season)
    }

    class Agronomist {
        -String activeSeason
        +Agronomist(String participantId, String name)
        +void selectSeason(String season)
        +void planCropRotation(Field field, String season, String crop)
        +String requestYieldAnalysis(CropYieldAnalysis analysis, String season, List~Field~ fields)
    }

    class Operator {
        -String activeSeason
        -WeatherService weatherService
        +Operator(String participantId, String name, WeatherService weatherService)
        +void selectSeason(String season)
        +FieldWork planFieldWork(Field field, String season, TechOperation operation)
        +void recordFieldWork(FieldWork work)
    }

    class Storekeeper {
        -String activeSeason
        +Storekeeper(String participantId, String name)
        +void selectSeason(String season)
        +boolean recordHarvest(Field field, String season, String receiptId, double quantity)
    }

    class Field {
        -String fieldId
        -String name
        -Map~String, String~ cropBySeason
        -List~TechOperation~ operations
        -Map~String, Double~ harvestBySeason
        -Set~String~ recordedReceiptIds
        -Set~String~ recordedHarvestKeys
        +Field(String fieldId, String name)
        +void assignCropPlan(String season, String crop)
        +void addOperation(TechOperation operation)
        +boolean recordHarvest(String receiptId, String season, double quantity)
        +boolean recordHarvest(String receiptId, String season, double quantity, String sourceNote)
        +Optional~String~ validateHarvest(String receiptId, String season, double quantity)
        +OptionalDouble getHarvestForSeason(String season)
        +boolean hasHarvestForSeason(String season)
        +String getFieldId()
        +String getName()
        +boolean hasOperation(TechOperation operation)
    }

    class FieldWork {
        -Field field
        -String season
        -TechOperation operation
        -WeatherService weatherService
        -FieldWorkStatus status
        +FieldWork(Field field, String season, TechOperation operation, WeatherService weatherService)
        +boolean complete()
        +FieldWorkStatus getStatus()
    }

    class FieldWorkStatus {
        <<enumeration>>
        PLANNED
        COMPLETED
    }

    class CropYieldAnalysis {
        +CropYieldAnalysis()
        +boolean hasDataForSeason(String season, List~Field~ fields)
        +String analyzeSeason(String season, List~Field~ fields)
    }

    class WeatherService {
        -boolean forecastAvailable
        +WeatherService(boolean forecastAvailable)
        +Optional~String~ getModeledContext(String fieldId, String season)
    }

    class TechOperation {
        -String operationType
        -String status
        -Field owner
        +TechOperation(String operationType)
        +void plan()
        +String getOperationType()
        +String getStatus()
        ~void assignTo(Field field)
        ~boolean belongsTo(Field field)
    }

    class DemoMain {
        -DemoMain()
        +main(String[] args) void$
    }

    FarmParticipant <|-- Agronomist
    FarmParticipant <|-- Operator
    FarmParticipant <|-- Storekeeper
    Agronomist ..|> IWorkPlan
    Operator ..|> IWorkPlan
    Storekeeper ..|> IWorkPlan
    Field "1" *-- "0..*" TechOperation : володіє
    FieldWork --> Field : для поля
    FieldWork --> TechOperation : виконує операцію
    FieldWork ..> WeatherService : залежність через конструктор
    FieldWork --> FieldWorkStatus : має стан
    Operator --> WeatherService : передає залежність
    Storekeeper --> Field : обліковує надходження
    Agronomist --> Field : планує культуру
    Agronomist --> CropYieldAnalysis : запитує аналіз
    CropYieldAnalysis --> Field : читає дані сезону
    DemoMain ..> Field : створює демонстраційні поля
    DemoMain ..> TechOperation : створює та призначає операції
    DemoMain ..> Agronomist : створює та запускає
    DemoMain ..> Operator : створює та запускає
    DemoMain ..> Storekeeper : створює та запускає
    DemoMain ..> WeatherService : передає залежність Operator
    DemoMain ..> CropYieldAnalysis : створює для запиту аналізу

    note for FarmParticipant "getParticipantId() є final."
    note for DemoMain "Композиційний корінь: створює демонстраційні об'єкти й послідовно викликає чотири етапи сценарію; main є static, клас не є предметною сутністю та не має CRC-картки."
    note for Agronomist "selectSeason(String) перевизначає абстрактну операцію."
    note for Field "recordHarvest має перевантаження для надходження з приміткою. validateHarvest повертає причину відмови без зміни даних. Ключ дубліката визначається полем, сезоном і кількістю, а не receiptId чи sourceNote. Обидва варіанти recordHarvest перевіряють і реєструють цей ключ; повтор повертає false без зміни harvestBySeason. recordedReceiptIds додатково відхиляє повторний receiptId. addOperation закріплює операцію за одним полем, а hasOperation перевіряє належність операції."
    note for FieldWorkStatus "PLANNED = ЗАПЛАНОВАНО; COMPLETED = ВИКОНАНО."
    note for FieldWork "Створюється зі статусом PLANNED; complete() перевіряє поле, непорожній сезон, операцію та її належність полю, і змінює стан на COMPLETED лише після успішної перевірки."
